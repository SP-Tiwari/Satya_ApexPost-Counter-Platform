Authorization: Bearer {{adminToken}}

### 42. DELETE /api/v2/shipments/{trackingNumber}: 204, the second shipment is still Created
DELETE {{baseUrl}}/api/v2/shipments/{{v2OtherTrackingNumber}}
Authorization: Bearer {{adminToken}}

# Week 4 Part D security: every error is Problem Details. These run after
# request 42, so APX-00000011 (v2TrackingNumber) exists and is PickedUp.

### 43. GET /api/v2/shipments/{trackingNumber}: 401, no bearer token
GET {{baseUrl}}/api/v2/shipments/{{v2TrackingNumber}}

### 44. GET /api/v2/shipments/{trackingNumber}: 401, a token that is not a valid signed JWT
GET {{baseUrl}}/api/v2/shipments/{{v2TrackingNumber}}
Authorization: Bearer not-a-valid-token

### 45. GET /api/v2/shipments/{trackingNumber}: 200, a valid token of any role (here Admin)
GET {{baseUrl}}/api/v2/shipments/{{v2TrackingNumber}}
Authorization: Bearer {{adminToken}}

### 46. PATCH /api/v2/shipments/{trackingNumber}/status: 403, an Admin token is not a Courier token
PATCH {{baseUrl}}/api/v2/shipments/{{v2TrackingNumber}}/status
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "status": "InTransit" }

### 47. DELETE /api/v2/shipments/{trackingNumber}: 403, a Courier token is not an Admin token
DELETE {{baseUrl}}/api/v2/shipments/{{v2TrackingNumber}}
Authorization: Bearer {{courierToken}}

### 48. POST /api/v2/shipments/{trackingNumber}/scans: 401, no bearer token
POST {{baseUrl}}/api/v2/shipments/{{v2TrackingNumber}}/scans
Content-Type: application/json

{
  "scans": [
    {
      "scanId": "scan::8b0d2f4a-6c8e-4a1c-9e3a-5c7e9a1b3d46",
      "trackingNumber": "{{v2TrackingNumber}}",
      "scanType": "InTransit",
      "courierId": "COURIER-DEMO-07",
      "location": "Nagpur hub",
      "scannedAtUtc": "2026-11-07T11:00:00Z"
    }
  ]
}

### 49. POST /api/v2/shipments/{trackingNumber}/scans: 403, a scan under another courierId refuses the whole batch
POST {{baseUrl}}/api/v2/shipments/{{v2TrackingNumber}}/scans
Authorization: Bearer {{courierToken}}
Content-Type: application/json

{
  "scans": [
    {
      "scanId": "scan::8b0d2f4a-6c8e-4a1c-9e3a-5c7e9a1b3d46",
      "trackingNumber": "{{v2TrackingNumber}}",
      "scanType": "InTransit",
      "courierId": "COURIER-DEMO-07",
      "location": "Nagpur hub",
      "scannedAtUtc": "2026-11-07T11:00:00Z"
    },
    {
      "scanId": "scan::1c3e5a7c-9e1a-4c3e-8a5c-7e9a1c3e5a78",
      "trackingNumber": "{{v2TrackingNumber}}",
      "scanType": "InTransit",
      "courierId": "COURIER-DEMO-99",
      "location": "Nagpur hub",
      "scannedAtUtc": "2026-11-07T11:05:00Z"
    }
  ]
}

### 50. POST /api/v2/shipments/{trackingNumber}/scans: 200, the courier's own scan, with the scan type as its name
POST {{baseUrl}}/api/v2/shipments/{{v2TrackingNumber}}/scans
Authorization: Bearer {{courierToken}}
Content-Type: application/json

{
  "scans": [
    {
      "scanId": "scan::8b0d2f4a-6c8e-4a1c-9e3a-5c7e9a1b3d46",
      "trackingNumber": "{{v2TrackingNumber}}",
      "scanType": "InTransit",
      "courierId": "COURIER-DEMO-07",
      "location": "Nagpur hub",
      "scannedAtUtc": "2026-11-07T11:00:00Z"
    }
  ]
}

