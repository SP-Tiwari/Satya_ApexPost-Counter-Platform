# ApexPost API: one success and at least one failure per endpoint, for both
# versions. Requests 1-24 use version 1 (deprecated, the Week 4 Part B
# contract); requests 25-42 use version 2. Every response carries the
# api-supported-versions and api-deprecated-versions headers. Requests 43-61
# cover Week 4 Part D security: 401, 403, the partner API key and a valid
# token (see SECURITY.md).
# Run the requests in order against a database migrated with AddTrackedShipments.
# All values are fictional. Start the API with:
#   dotnet run --project src/ApexPost.Api --launch-profile https
# Requests 0a and 0b get Development tokens from POST /dev/token; the API
# needs a signing key in User Secrets first (dotnet user-jwts create). The
# partner key is read from the APEXPOST_PARTNER_API_KEY environment variable
# of the editor's process, and must match a PartnerApiKeys entry in the API's
# User Secrets. No token or key is stored in this file.

@baseUrl = https://localhost:7280
@trackingNumber = APX-00000001
@otherTrackingNumber = APX-00000002
@scanId = scan::0b6f3c1a-5d2e-4f8b-9a71-2c4e6d8f0a13
@v2TrackingNumber = APX-00000011
@v2OtherTrackingNumber = APX-00000012
@courierToken = {{courierTokenRequest.response.body.$.accessToken}}
@adminToken = {{adminTokenRequest.response.body.$.accessToken}}
@partnerApiKey = {{$processEnv APEXPOST_PARTNER_API_KEY}}

### 0a. POST /dev/token: 200, a Courier token for COURIER-DEMO-07 (Development only)
# @name courierTokenRequest
POST {{baseUrl}}/dev/token
Content-Type: application/json

{ "courierId": "COURIER-DEMO-07", "role": "Courier" }

### 0b. POST /dev/token: 200, an Admin token (Development only)
# @name adminTokenRequest
POST {{baseUrl}}/dev/token
Content-Type: application/json

{ "role": "Admin" }

### 1. POST /api/v1/shipments: 201 Created with a Location header
POST {{baseUrl}}/api/v1/shipments
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "trackingNumber": "{{trackingNumber}}",
  "recipientName": "DEMO Recipient",
  "recipientPhone": "+919876543210",
  "recipientAddress": "1 Demo Street",
  "recipientCity": "Pune",
  "weightKg": 2.5
}

### 2. POST /api/v1/shipments: 409, the tracking number already exists
POST {{baseUrl}}/api/v1/shipments
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "trackingNumber": "{{trackingNumber}}",
  "recipientName": "DEMO Recipient",
  "recipientPhone": "+919876543210",
  "recipientAddress": "1 Demo Street",
  "recipientCity": "Pune",
  "weightKg": 2.5
}

### 3. POST /api/v1/shipments: 400 ValidationProblemDetails (tracking number, phone, weight, missing city)
POST {{baseUrl}}/api/v1/shipments
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "trackingNumber": "APX-123",
  "recipientName": "DEMO Recipient",
  "recipientPhone": "98765",
  "recipientAddress": "1 Demo Street",
  "weightKg": 75
}

### 4. POST /api/v1/shipments: 415, not JSON
POST {{baseUrl}}/api/v1/shipments
Authorization: Bearer {{adminToken}}
Content-Type: text/plain

trackingNumber=APX-00000003

### 5. POST /api/v1/shipments: 201, a second shipment for the filters and the scan rules
POST {{baseUrl}}/api/v1/shipments
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "trackingNumber": "{{otherTrackingNumber}}",
  "recipientName": "DEMO Second Recipient",
  "recipientPhone": "+919812345678",
  "recipientAddress": "2 Demo Road",
  "recipientCity": "Mumbai",
  "weightKg": 0.1
}

### 6. GET /api/v1/shipments: 200, the first page (pageSize defaults to 20)
GET {{baseUrl}}/api/v1/shipments
Authorization: Bearer {{adminToken}}

### 7. GET /api/v1/shipments: 200, filtered by status and city
GET {{baseUrl}}/api/v1/shipments?page=1&pageSize=50&status=Created&city=Pune
Authorization: Bearer {{adminToken}}

### 8. GET /api/v1/shipments: 400, pageSize above the maximum of 50
GET {{baseUrl}}/api/v1/shipments?pageSize=51
Authorization: Bearer {{adminToken}}

### 9. GET /api/v1/shipments/{trackingNumber}: 200
GET {{baseUrl}}/api/v1/shipments/{{trackingNumber}}
Authorization: Bearer {{courierToken}}

### 10. GET /api/v1/shipments/{trackingNumber}: 404, unknown tracking number
GET {{baseUrl}}/api/v1/shipments/APX-99999999
Authorization: Bearer {{courierToken}}

### 11. PUT /api/v1/shipments/{trackingNumber}: 200, details replaced
PUT {{baseUrl}}/api/v1/shipments/{{trackingNumber}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "recipientName": "DEMO Recipient",
  "recipientPhone": "+919876543210",
  "recipientAddress": "10 Demo Avenue",
  "recipientCity": "Pune",
  "weightKg": 3
}

### 12. PUT /api/v1/shipments/{trackingNumber}: 400, the weight is outside 0.1 to 70 kg
PUT {{baseUrl}}/api/v1/shipments/{{trackingNumber}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "recipientName": "DEMO Recipient",
  "recipientPhone": "+919876543210",
  "recipientAddress": "10 Demo Avenue",
  "recipientCity": "Pune",
  "weightKg": 0.05
}

### 13. PATCH /api/v1/shipments/{trackingNumber}/status: 200, Created to PickedUp (status 1)
# Statuses are numbers in Part B: 0 Created, 1 PickedUp, 2 InTransit,
# 3 OutForDelivery, 4 Delivered, 5 Failed.
PATCH {{baseUrl}}/api/v1/shipments/{{trackingNumber}}/status
Authorization: Bearer {{courierToken}}
Content-Type: application/json

{ "status": 1 }

### 14. PATCH /api/v1/shipments/{trackingNumber}/status: 409, PickedUp cannot go straight to Delivered
PATCH {{baseUrl}}/api/v1/shipments/{{trackingNumber}}/status
Authorization: Bearer {{courierToken}}
Content-Type: application/json

{ "status": 4 }

### 15. PATCH /api/v1/shipments/{trackingNumber}/status: 400, not a defined status
PATCH {{baseUrl}}/api/v1/shipments/{{trackingNumber}}/status
Authorization: Bearer {{courierToken}}
Content-Type: application/json

{ "status": 42 }

### 16. DELETE /api/v1/shipments/{trackingNumber}: 409, the shipment is no longer Created
DELETE {{baseUrl}}/api/v1/shipments/{{trackingNumber}}
Authorization: Bearer {{adminToken}}

### 17. POST /api/v1/shipments/{trackingNumber}/scans: 200, accepted 2
# Scan types are numbers: 0 Pickup, 1 InTransit, 2 Delivered, 3 Failed.
POST {{baseUrl}}/api/v1/shipments/{{trackingNumber}}/scans
Authorization: Bearer {{courierToken}}
Content-Type: application/json

{
  "scans": [
    {
      "scanId": "{{scanId}}",
      "trackingNumber": "{{trackingNumber}}",
      "scanType": 0,
      "courierId": "COURIER-DEMO-07",
      "location": "Pune hub",
      "scannedAtUtc": "2026-11-07T08:00:00Z",
      "notes": "Collected from DEMO sender"
    },
    {
      "scanId": "scan::7d1e9a42-3b6c-4e8f-b2a5-9c0d1f3e5a77",
      "trackingNumber": "{{trackingNumber}}",
      "scanType": 1,
      "courierId": "COURIER-DEMO-07",
      "location": "Pune sorting centre",
      "scannedAtUtc": "2026-11-07T09:30:00Z"
    }
  ]
}

### 18. POST /api/v1/shipments/{trackingNumber}/scans: 200, the same scan again is a duplicate, plus two rejections
POST {{baseUrl}}/api/v1/shipments/{{trackingNumber}}/scans
Authorization: Bearer {{courierToken}}
Content-Type: application/json

{
  "scans": [
    {
      "scanId": "{{scanId}}",
      "trackingNumber": "{{trackingNumber}}",
      "scanType": 0,
      "courierId": "COURIER-DEMO-07",
      "location": "Pune hub",
      "scannedAtUtc": "2026-11-07T08:00:00Z"
    },
    {
      "scanId": "not-a-scan-id",
      "trackingNumber": "{{trackingNumber}}",
      "scanType": 1,
      "courierId": "COURIER-DEMO-07",
      "location": "Pune hub",
      "scannedAtUtc": "2026-11-07T08:10:00Z"
    },
    {
      "scanId": "scan::4a8c2e6f-1b3d-4f5a-8c7e-0d2f4b6a8c91",
      "trackingNumber": "{{otherTrackingNumber}}",
      "scanType": 1,
      "courierId": "COURIER-DEMO-07",
      "location": "Pune hub",
      "scannedAtUtc": "2026-11-07T08:20:00Z"
    }
  ]
}

### 19. POST /api/v1/shipments/{trackingNumber}/scans: 400, a scan time in the future
POST {{baseUrl}}/api/v1/shipments/{{trackingNumber}}/scans
Authorization: Bearer {{courierToken}}
Content-Type: application/json

{
  "scans": [
    {
      "scanId": "scan::9e3b5d7f-2a4c-4e6b-8d0f-1a3c5e7b9d24",
