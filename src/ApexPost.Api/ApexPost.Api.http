DELETE {{baseUrl}}/api/v1/shipments/{{otherTrackingNumber}}
Authorization: Bearer {{adminToken}}

### 24. DELETE /api/v1/shipments/{trackingNumber}: 404, it is gone
DELETE {{baseUrl}}/api/v1/shipments/{{otherTrackingNumber}}
Authorization: Bearer {{adminToken}}

# Version 2: the same endpoints, requests and status codes. A shipment is
# returned with a nested recipient, its latestScan and its status as a name.

