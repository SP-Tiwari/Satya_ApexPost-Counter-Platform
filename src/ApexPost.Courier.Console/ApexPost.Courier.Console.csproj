<Project Sdk="Microsoft.NET.Sdk">

  <!-- Week 4 Part D: the courier client, a .NET console application used
       instead of a .NET MAUI app (ADR 0030). It connects to ApexPost.Api
       through ApexPost.Courier.Sync. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Every JSON body uses the source-generated CourierJsonContext (D8);
         reflection-based System.Text.Json serialization is switched off, so a
         type missing from the context fails instead of silently using it. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApexPost.Courier.Sync\ApexPost.Courier.Sync.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
