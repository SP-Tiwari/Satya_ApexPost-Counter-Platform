{
  "openapi": "3.1.1",
  "info": {
    "title": "ApexPost Logistics API",
    "description": "Tracked shipments and offline courier scan uploads for ApexPost Logistics. Every error response is a Problem Details object (RFC 9457). Version 1.0 is deprecated; use version 2.0.",
    "contact": {
      "name": "ApexPost Platform Team",
      "url": "https://developers.apexpost.example",
      "email": "platform-team@apexpost.example"
    },
    "version": "v1"
  },
  "servers": [
    {
      "url": "http://localhost:5280/"
    }
  ],
  "paths": {
    "/api/v1/shipments/{trackingNumber}/scans": {
      "post": {
        "tags": [
          "Scans"
        ],
        "summary": "Upload offline courier scans",
        "description": "Uploads a batch of scans recorded offline on a courier device. Idempotent by scan ID: a scan already recorded for the shipment, or\r\nrepeated in the batch, is counted in `duplicatesSkipped` and not\r\nstored again. A scan with a malformed ID, another shipment's tracking\r\nnumber or an ID recorded for another shipment is counted in\r\n`rejected`, with its reason, and the rest of the batch is still\r\nprocessed. Scans never change the shipment's status.",
        "operationId": "UploadShipmentScans",
        "parameters": [
          {
            "name": "trackingNumber",
            "in": "path",
            "description": "The tracking number: APX- followed by eight digits, such as APX-00000001.",
            "required": true,
            "schema": {
              "pattern": "^APX-\\d{8}$",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "One to 100 scans.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScanUploadRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ScanUploadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "404": {
            "description": "No shipment has the tracking number, or it is not APX- followed by eight digits.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "An unexpected error occurred.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "The batch was processed; the counts say what happened to each scan.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanUploadResponse"
                }
              }
            }
          },
          "400": {
            "description": "The batch failed validation, such as a scan time in the future, or its JSON is malformed.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "A simultaneous upload stored the same scans and the retry could not resolve it.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "415": {
            "description": "The body is not application/json.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "deprecated": true
      },
      "get": {
        "tags": [
          "Scans"
        ],
        "summary": "Get a shipment's scan history",
        "description": "Returns every scan recorded for the shipment, oldest first.",
        "operationId": "GetShipmentScans",
        "parameters": [
          {
            "name": "trackingNumber",
            "in": "path",
            "description": "The tracking number: APX- followed by eight digits, such as APX-00000001.",
            "required": true,
            "schema": {
              "pattern": "^APX-\\d{8}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "404": {
            "description": "No shipment has the tracking number, or it is not APX- followed by eight digits.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "An unexpected error occurred.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "The scan history.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ScanResponse"
                  }
                }
              }
            }
          }
        },
        "deprecated": true
      }
    },
    "/api/v1/shipments": {
      "get": {
        "tags": [
          "Shipments"
        ],
        "summary": "List shipments by page, status and city",
        "description": "Returns one page of shipments, ordered by tracking number and optionally\r\nfiltered by status and city. `page` defaults to 1 and\r\n`pageSize` to 20; the largest page size is 50.",
        "operationId": "ListShipments",
        "parameters": [
          {
            "name": "Page",
            "in": "query",
            "description": "The page number, starting at 1. Defaults to 1.",
            "schema": {
              "maximum": 2147483647,
              "minimum": 1,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "PageSize",
            "in": "query",
            "description": "The number of shipments per page, from 1 to 50. Defaults to 20.",
            "schema": {
              "maximum": 50,
              "minimum": 1,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "Status",
            "in": "query",
            "description": "Only shipments with this status, when given.",
            "schema": {
              "$ref": "#/components/schemas/ShipmentStatus"
            }
          },
          {
            "name": "City",
            "in": "query",
            "description": "Only shipments to this city, when given; at most 100 characters.",
            "schema": {
              "maxLength": 100,
              "type": "string"
            }
          }
        ],
        "responses": {
          "500": {
            "description": "An unexpected error occurred.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "The page of shipments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShipmentPageResponse"
                }
              }
            }
          },
          "400": {
            "description": "A query value is invalid, such as a page size above 50 or an unknown status.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          }
        },
        "deprecated": true
      },
      "post": {
        "tags": [
          "Shipments"
        ],
        "summary": "Create a shipment",
        "description": "Creates the shipment with the status Created. The `Location` header of the 201 response is the URL of the new\r\nshipment.",
        "operationId": "CreateShipment",
        "requestBody": {
          "description": "The tracking number and the shipment details.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateShipmentRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateShipmentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "500": {
            "description": "An unexpected error occurred.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "201": {
            "description": "The shipment was created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShipmentResponse"
                }
              }
            }
          },
          "400": {
            "description": "The request failed validation or its JSON is malformed.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "A shipment with this tracking number already exists.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "415": {
            "description": "The body is not application/json.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "deprecated": true
      }
    },
    "/api/v1/shipments/{trackingNumber}": {
      "get": {
        "tags": [
          "Shipments"
        ],
        "summary": "Get a shipment by tracking number",
        "description": "Returns the shipment's recipient, weight and current status.",
        "operationId": "GetShipment",
        "parameters": [
          {
            "name": "trackingNumber",
            "in": "path",
            "description": "The tracking number: APX- followed by eight digits, such as APX-00000001.",
            "required": true,
            "schema": {
              "pattern": "^APX-\\d{8}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "500": {
            "description": "An unexpected error occurred.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "The shipment.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShipmentResponse"
                }
              }
            }
          },
          "404": {
            "description": "No shipment has the tracking number, or it is not APX- followed by eight digits.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "deprecated": true
      },
      "put": {
        "tags": [
          "Shipments"
        ],
        "summary": "Replace a shipment's editable details",
        "description": "The editable details are the recipient's name, phone, address and city,\r\nand the weight. The tracking number and the status do not change.",
        "operationId": "ReplaceShipment",
        "parameters": [
          {
            "name": "trackingNumber",
            "in": "path",
            "description": "The tracking number: APX- followed by eight digits, such as APX-00000001.",
            "required": true,
            "schema": {
              "pattern": "^APX-\\d{8}$",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "The new details.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateShipmentRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateShipmentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "500": {
            "description": "An unexpected error occurred.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "The details were replaced.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShipmentResponse"
                }
              }
            }
          },
          "400": {
            "description": "The request failed validation or its JSON is malformed.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "No shipment has the tracking number, or it is not APX- followed by eight digits.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Another change was made to the shipment at the same time.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "415": {
            "description": "The body is not application/json.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "deprecated": true
      },
      "delete": {
        "tags": [
          "Shipments"
        ],
        "summary": "Delete a shipment in Created status",
        "description": "Deletes the shipment and its scans. A shipment that has moved past Created\r\ncannot be deleted.",
        "operationId": "DeleteShipment",
        "parameters": [
          {
            "name": "trackingNumber",
            "in": "path",
            "description": "The tracking number: APX- followed by eight digits, such as APX-00000001.",
            "required": true,
            "schema": {
              "pattern": "^APX-\\d{8}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "500": {
            "description": "An unexpected error occurred.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "204": {
            "description": "The shipment was deleted."
          },
          "404": {
            "description": "No shipment has the tracking number, or it is not APX- followed by eight digits.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "The shipment's status is not Created, or another change was made to it at the same time.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "deprecated": true
      }
    },
    "/api/v1/shipments/{trackingNumber}/status": {
      "patch": {
        "tags": [
          "Shipments"
        ],
        "summary": "Change a shipment's status",
        "description": "Moves the shipment to its next status. The allowed path is Created, PickedUp, InTransit, OutForDelivery and then\r\nDelivered or Failed. Each status moves only to the next one, and\r\nDelivered and Failed are final.",
        "operationId": "ChangeShipmentStatus",
        "parameters": [
          {
            "name": "trackingNumber",
            "in": "path",
            "description": "The tracking number: APX- followed by eight digits, such as APX-00000001.",
            "required": true,
            "schema": {
              "pattern": "^APX-\\d{8}$",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "The new status.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateStatusRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateStatusRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "500": {
            "description": "An unexpected error occurred.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "The status was changed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShipmentResponse"
                }
              }
            }
          },
          "400": {
            "description": "The status is missing or not a defined status, or the JSON is malformed.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "No shipment has the tracking number, or it is not APX- followed by eight digits.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "The transition is not allowed, or another change was made to the shipment at the same time.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "415": {
            "description": "The body is not application/json.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "deprecated": true
      }
    }
  },
  "components": {
    "schemas": {
      "CreateShipmentRequest": {
        "required": [
          "trackingNumber",
          "recipientName",
          "recipientPhone",
          "recipientAddress",
          "recipientCity",
          "weightKg"
        ],
        "type": "object",
        "properties": {
          "trackingNumber": {
            "examples": [
              "APX-00000001"
            ],
            "pattern": "^APX-[0-9]{8}$",
            "type": [
              "null",
              "string"
            ],
            "description": "The tracking number: APX- followed by eight digits. Required and unique."
          },
          "recipientName": {
            "examples": [
              "DEMO Recipient"
            ],
            "maxLength": 100,
            "type": [
              "null",
              "string"
            ],
            "description": "The recipient's full name. Required; at most 100 characters."
          },
          "recipientPhone": {
            "examples": [
              "+919876543210"
            ],
            "maxLength": 20,
            "pattern": "^\\+[1-9][0-9]{7,14}$",
            "type": [
              "null",
              "string"
            ],
            "description": "The recipient's phone number in E.164 format. Required; at most 20 characters."
          },
          "recipientAddress": {
            "examples": [
              "1 Demo Street"
            ],
            "maxLength": 200,
            "type": [
              "null",
              "string"
            ],
            "description": "The delivery address. Required; at most 200 characters."
          },
          "recipientCity": {
            "examples": [
              "Pune"
            ],
            "maxLength": 100,
            "type": [
              "null",
              "string"
            ],
            "description": "The delivery city. Required; at most 100 characters."
          },
          "weightKg": {
            "examples": [
              2.5
            ],
            "maximum": 70,
            "minimum": 0.1,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "description": "The weight in kilograms. Required; from 0.1 to 70.",
            "format": "decimal"
          }
        },
        "description": "A new shipment: its tracking number and details."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RejectedScanResponse": {
        "required": [
          "scanId",
          "reason"
        ],
        "type": "object",
        "properties": {
          "scanId": {
            "type": "string",
            "description": "The scan ID as it was uploaded."
          },
          "reason": {
            "type": "string",
            "description": "Why the scan was refused."
          }
        },
        "description": "A scan that was refused, and why."
      },
      "ScanResponse": {
        "required": [
          "scanId",
          "scanType",
          "courierId",
          "location",
          "scannedAtUtc",
          "notes"
        ],
        "type": "object",
        "properties": {
          "scanId": {
            "type": "string",
            "description": "The device's scan ID, `scan::` followed by a GUID."
          },
          "scanType": {
            "description": "The scan type: 0 Pickup, 1 InTransit, 2 Delivered or 3 Failed.",
            "$ref": "#/components/schemas/ShipmentScanType"
          },
          "courierId": {
            "type": "string",
            "description": "The courier who scanned the shipment."
          },
          "location": {
            "type": "string",
            "description": "Where the scan was made."
          },
          "scannedAtUtc": {
            "type": "string",
            "description": "When the scan was made.",
            "format": "date-time"
          },
          "notes": {
            "type": [
              "null",
              "string"
            ],
            "description": "The courier's notes, or null."
          }
        },
        "description": "A recorded scan of a shipment."
      },
      "ScanUploadItem": {
        "required": [
          "scanId",
          "trackingNumber",
          "scanType",
          "courierId",
          "location",
          "scannedAtUtc"
        ],
        "type": "object",
        "properties": {
          "scanId": {
            "examples": [
              "scan::3f2504e0-4f89-41d3-9a0c-0305e82c3301"
            ],
            "type": [
              "null",
              "string"
            ],
            "description": "The device's document ID, `scan::` followed by a GUID. Required. It\r\nmakes the upload idempotent: an ID already recorded is not stored again."
          },
          "trackingNumber": {
            "examples": [
              "APX-00000001"
            ],
            "type": [
              "null",
              "string"
            ],
            "description": "The scanned shipment's tracking number; it must match the route. Required."
          },
          "scanType": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "The scan type. Required: 0 Pickup, 1 InTransit, 2 Delivered or 3 Failed.",
                "examples": [
                  0
                ],
                "$ref": "#/components/schemas/ShipmentScanType"
              }
            ]
          },
          "courierId": {
            "examples": [
              "COURIER-DEMO-07"
            ],
            "maxLength": 50,
            "type": [
              "null",
              "string"
            ],
            "description": "The courier who scanned the shipment. Required; at most 50 characters."
          },
          "location": {
            "examples": [
              "Pune hub"
            ],
            "maxLength": 200,
            "type": [
              "null",
              "string"
            ],
            "description": "Where the scan was made. Required; at most 200 characters."
          },
          "scannedAtUtc": {
            "examples": [
              "2026-11-07T09:30:00Z"
            ],
            "type": [
              "null",
              "string"
            ],
            "description": "When the scan was made. Required, and not later than the server's current UTC time.",
            "format": "date-time"
          },
          "notes": {
            "maxLength": 500,
            "type": [
              "null",
              "string"
            ],
            "description": "The courier's optional notes; at most 500 characters."
          }
        },
        "description": "One scan as the courier device recorded it."
      },
      "ScanUploadRequest": {
        "required": [
          "scans"
        ],
        "type": "object",
        "properties": {
          "scans": {
            "maxItems": 100,
            "minItems": 1,
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/ScanUploadItem"
            },
            "description": "The scans, from 1 to 100. Required."
          }
        },
        "description": "A batch of offline scans from a courier device (Week 4 Part A). A malformed\r\nscan ID or a tracking number that differs from the route does not fail the\r\nrequest: that scan is returned as rejected, with its reason."
      },
      "ScanUploadResponse": {
        "required": [
          "accepted",
          "duplicatesSkipped",
          "rejected",
          "rejections"
        ],
        "type": "object",
        "properties": {
          "accepted": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The number of scans stored.",
            "format": "int32"
          },
          "duplicatesSkipped": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The number of scans already recorded, or repeated in the batch, and not stored again.",
            "format": "int32"
          },
          "rejected": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The number of scans refused; `rejections` gives the reason for each.",
            "format": "int32"
          },
          "rejections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RejectedScanResponse"
            },
            "description": "Each refused scan and its reason."
          }
        },
        "description": "What happened to each scan in an upload: the three counts of B6."
      },
      "ShipmentPageResponse": {
        "required": [
          "items",
          "page",
          "pageSize",
          "totalCount"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ShipmentResponse"
            },
            "description": "The shipments on this page, ordered by tracking number."
          },
          "page": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The page number, starting at 1.",
            "format": "int32"
          },
          "pageSize": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The largest number of shipments on a page.",
            "format": "int32"
          },
          "totalCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The number of shipments that match the filters, on all pages.",
            "format": "int32"
          }
        },
        "description": "One page of shipments."
      },
      "ShipmentResponse": {
        "required": [
          "trackingNumber",
          "recipientName",
          "recipientPhone",
          "recipientAddress",
          "recipientCity",
          "weightKg",
          "status"
        ],
        "type": "object",
        "properties": {
          "trackingNumber": {
            "type": "string",
            "description": "The tracking number: APX- followed by eight digits."
          },
          "recipientName": {
            "type": "string",
            "description": "The recipient's full name."
          },
          "recipientPhone": {
            "type": "string",
            "description": "The recipient's phone number in E.164 format."
          },
          "recipientAddress": {
            "type": "string",
            "description": "The delivery address."
          },
          "recipientCity": {
            "type": "string",
            "description": "The delivery city."
          },
          "weightKg": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "description": "The weight in kilograms.",
            "format": "decimal"
          },
          "status": {
            "description": "The current status: 0 Created, 1 PickedUp, 2 InTransit, 3 OutForDelivery,\r\n4 Delivered or 5 Failed.",
            "$ref": "#/components/schemas/ShipmentStatus"
          }
        },
        "description": "A tracked shipment."
      },
      "ShipmentScanType": {
        "enum": [
          0,
          1,
          2,
          3
        ],
        "type": "integer",
        "x-enumNames": [
          "Pickup",
          "InTransit",
          "Delivered",
          "Failed"
        ]
      },
      "ShipmentStatus": {
        "enum": [
          0,
          1,
          2,
          3,
          4,
          5
        ],
        "type": "integer",
        "x-enumNames": [
          "Created",
          "PickedUp",
          "InTransit",
          "OutForDelivery",
          "Delivered",
          "Failed"
        ]
      },
      "UpdateShipmentRequest": {
        "required": [
          "recipientName",
          "recipientPhone",
          "recipientAddress",
          "recipientCity",
          "weightKg"
        ],
        "type": "object",
        "properties": {
          "recipientName": {
            "examples": [
              "DEMO Recipient"
            ],
            "maxLength": 100,
            "type": [
              "null",
              "string"
            ],
            "description": "The recipient's full name. Required; at most 100 characters."
          },
          "recipientPhone": {
            "examples": [
              "+919876543210"
            ],
            "maxLength": 20,
            "pattern": "^\\+[1-9][0-9]{7,14}$",
            "type": [
              "null",
              "string"
            ],
            "description": "The recipient's phone number in E.164 format. Required; at most 20 characters."
          },
          "recipientAddress": {
            "examples": [
              "1 Demo Street"
            ],
            "maxLength": 200,
            "type": [
              "null",
              "string"
            ],
            "description": "The delivery address. Required; at most 200 characters."
          },
          "recipientCity": {
            "examples": [
              "Pune"
            ],
            "maxLength": 100,
            "type": [
              "null",
              "string"
            ],
            "description": "The delivery city. Required; at most 100 characters."
          },
          "weightKg": {
            "examples": [
              2.5
            ],
            "maximum": 70,
            "minimum": 0.1,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "description": "The weight in kilograms. Required; from 0.1 to 70.",
            "format": "decimal"
          }
        },
        "description": "A shipment's new editable details. The tracking number comes from the route\r\nand cannot change."
      },
      "UpdateStatusRequest": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "The next status. Required: 0 Created, 1 PickedUp, 2 InTransit,\r\n3 OutForDelivery, 4 Delivered or 5 Failed.",
                "examples": [
                  1
                ],
                "$ref": "#/components/schemas/ShipmentStatus"
              }
            ]
          }
        },
        "description": "A shipment's new status."
      },
      "ValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
