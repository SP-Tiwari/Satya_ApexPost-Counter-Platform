{
  "openapi": "3.1.1",
  "info": {
    "title": "ApexPost Logistics API",
    "description": "Tracked shipments and offline courier scan uploads for ApexPost Logistics. Every error response is a Problem Details object (RFC 9457).",
    "contact": {
      "name": "ApexPost Platform Team",
      "url": "https://developers.apexpost.example",
      "email": "platform-team@apexpost.example"
    },
    "version": "v2"
  },
  "servers": [
    {
      "url": "https://localhost:7280/"
    }
  ],
  "paths": {
    "/api/v2/shipments/{trackingNumber}/scans": {
      "post": {
        "tags": [
          "Scans"
        ],
        "summary": "Upload offline courier scans",
        "description": "Requires a bearer token with the Courier role, and every scan must carry\r\nthe token's own courierId; otherwise the whole batch is refused with 403.\r\nUploads a batch of scans recorded offline on a courier device. Idempotent by scan ID: a scan already recorded for the shipment, or\r\nrepeated in the batch, is counted in `duplicatesSkipped` and not\r\nstored again. A scan with a malformed ID, another shipment's tracking\r\nnumber or an ID recorded for another shipment is counted in\r\n`rejected`, with its reason, and the rest of the batch is still\r\nprocessed. Scans never change the shipment's status.",
        "operationId": "UploadShipmentScans",
        "parameters": [
          {
            "name": "trackingNumber",
            "in": "path",
            "description": "The tracking number: APX- followed by eight digits, such as APX-00000001.",
            "required": true,
            "schema": {
              "pattern": "^APX-\\d{8}$",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "One to 100 scans.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScanUploadRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ScanUploadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "404": {
            "description": "No shipment has the tracking number, or it is not APX- followed by eight digits.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "An unexpected error occurred.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "The batch was processed; the counts say what happened to each scan.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanUploadResponse"
                }
              }
            }
          },
          "400": {
            "description": "The batch failed validation, such as a scan time in the future, or its JSON is malformed.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "The bearer token is missing, invalid or expired.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "The token does not have the Courier role, or a scan's courierId is not the token's courierId; no scan is stored.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "A simultaneous upload stored the same scans and the retry could not resolve it.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "415": {
            "description": "The body is not application/json.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      },
      "get": {
        "tags": [
          "Scans"
        ],
        "summary": "Get a shipment's scan history",
        "description": "Returns every scan recorded for the shipment, oldest first.",
        "operationId": "GetShipmentScans",
        "parameters": [
          {
            "name": "trackingNumber",
            "in": "path",
            "description": "The tracking number: APX- followed by eight digits, such as APX-00000001.",
            "required": true,
            "schema": {
              "pattern": "^APX-\\d{8}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "404": {
            "description": "No shipment has the tracking number, or it is not APX- followed by eight digits.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "An unexpected error occurred.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "The bearer token is missing, invalid or expired.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "The scan history.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ScanResponse"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/v2/partner/shipments/{trackingNumber}": {
      "get": {
        "tags": [
          "Partner"
        ],
        "summary": "Track a shipment as a partner",
        "description": "Returns a shipment's status, destination city and latest scan for a\r\npartner system. The recipient's name, phone number and address are not\r\nincluded. Requires a valid partner API key in the `X-Api-Key`\r\nheader.",
        "operationId": "GetPartnerShipment",
        "parameters": [
          {
            "name": "trackingNumber",
            "in": "path",
            "description": "The tracking number: APX- followed by eight digits, such as APX-00000001.",
            "required": true,
            "schema": {
              "pattern": "^APX-\\d{8}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "401": {
            "description": "The X-Api-Key header is missing, or its key is not a partner key.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "An unexpected error occurred, or no partner key is configured.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "The shipment's tracking status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartnerShipmentResponse"
                }
              }
            }
          },
          "404": {
            "description": "No shipment has the tracking number, or it is not APX- followed by eight digits.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "PartnerApiKey": [ ]
          }
        ]
      }
    },
    "/api/v2/shipments": {
      "get": {
        "tags": [
          "Shipments"
        ],
        "summary": "List shipments by page, status and city",
        "description": "Returns one page of shipments, ordered by tracking number and optionally\r\nfiltered by status and city. `page` defaults to 1 and\r\n`pageSize` to 20; the largest page size is 50.",
        "operationId": "ListShipments",
        "parameters": [
          {
            "name": "Page",
            "in": "query",
            "description": "The page number, starting at 1. Defaults to 1.",
            "schema": {
              "maximum": 2147483647,
              "minimum": 1,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "PageSize",
            "in": "query",
            "description": "The number of shipments per page, from 1 to 50. Defaults to 20.",
            "schema": {
              "maximum": 50,
              "minimum": 1,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "Status",
            "in": "query",
            "description": "Only shipments with this status, when given.",
            "schema": {
              "$ref": "#/components/schemas/ShipmentStatus"
            }
          },
          {
            "name": "City",
            "in": "query",
            "description": "Only shipments to this city, when given; at most 100 characters.",
            "schema": {
              "maxLength": 100,
              "type": "string"
            }
          }
        ],
        "responses": {
          "500": {
            "description": "An unexpected error occurred.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "The bearer token is missing, invalid or expired.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "The page of shipments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShipmentPageResponse"
                }
              }
            }
          },
          "400": {
            "description": "A query value is invalid, such as a page size above 50 or an unknown status.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      },
      "post": {
