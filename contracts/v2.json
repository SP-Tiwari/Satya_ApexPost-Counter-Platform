    "/api/v2/shipments/{trackingNumber}/status": {
      "patch": {
        "tags": [
          "Shipments"
        ],
        "summary": "Change a shipment's status",
        "description": "Moves the shipment to its next status, given by name, such as\r\n`{ \"status\": \"PickedUp\" }`. The allowed path is Created, PickedUp,\r\nInTransit, OutForDelivery and then Delivered or Failed. Each status\r\nmoves only to the next one, and Delivered and Failed are final.",
        "operationId": "ChangeShipmentStatus",
        "parameters": [
          {
            "name": "trackingNumber",
            "in": "path",
            "description": "The tracking number: APX- followed by eight digits, such as APX-00000001.",
            "required": true,
            "schema": {
              "pattern": "^APX-\\d{8}$",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "The new status.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateStatusRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateStatusRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "500": {
            "description": "An unexpected error occurred.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "The status was changed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShipmentResponse"
                }
              }
            }
          },
          "400": {
            "description": "The status is missing or not a defined status, or the JSON is malformed.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "The bearer token is missing, invalid or expired.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "The token does not have the Courier role.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "No shipment has the tracking number, or it is not APX- followed by eight digits.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "The transition is not allowed, or another change was made to the shipment at the same time.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "415": {
            "description": "The body is not application/json.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CreateShipmentRequest": {
        "required": [
          "trackingNumber",
          "recipientName",
          "recipientPhone",
          "recipientAddress",
          "recipientCity",
          "weightKg"
        ],
        "type": "object",
        "properties": {
          "trackingNumber": {
            "examples": [
              "APX-00000001"
            ],
            "pattern": "^APX-[0-9]{8}$",
            "type": [
              "null",
              "string"
            ],
            "description": "The tracking number: APX- followed by eight digits. Required and unique."
          },
          "recipientName": {
            "examples": [
              "DEMO Recipient"
            ],
            "maxLength": 100,
            "type": [
              "null",
              "string"
            ],
            "description": "The recipient's full name. Required; at most 100 characters."
          },
          "recipientPhone": {
            "examples": [
              "+919876543210"
            ],
            "maxLength": 20,
            "pattern": "^\\+[1-9][0-9]{7,14}$",
            "type": [
              "null",
              "string"
            ],
            "description": "The recipient's phone number in E.164 format. Required; at most 20 characters."
          },
          "recipientAddress": {
            "examples": [
              "1 Demo Street"
            ],
            "maxLength": 200,
            "type": [
              "null",
              "string"
            ],
